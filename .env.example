# fc2-harbor environment template.
#
# Copy to `.env` and fill in real values. `.env` is git-ignored.
# Never commit real tokens, passwords, proxy credentials or cookies.
#
# Placeholders below are deliberately empty / obviously fake.

# --- Telegram -------------------------------------------------------------
# Subscription push bot (M4). Leave empty until the subscription bot is enabled.
SUBSCRIPTION_BOT_TOKEN=
# Manual magnet-submission bot (M1).
MANUAL_BOT_TOKEN=
# Comma separated numeric Telegram user IDs allowed to use both bots.
TELEGRAM_ALLOWED_USER_IDS=

# --- Proxies --------------------------------------------------------------
# Credentials are embedded in the URL; keep them only in .env / docker secrets.
JP_PROXY_URL=socks5h://user:password@proxy.example.com:1080
JP_BACKUP_PROXY_URL=http://user:password@proxy-backup.example.com:8080

# --- qBittorrent ----------------------------------------------------------
# NAS-local service: always reached directly, never through a proxy.
QBITTORRENT_URL=http://192.168.1.10:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=change-me

# --- Transmission (optional, disabled by default) -------------------------
TRANSMISSION_URL=http://192.168.1.10:9091
TRANSMISSION_USERNAME=
TRANSMISSION_PASSWORD=

# --- Translation (M3) -----------------------------------------------------
TRANSLATION_BASE_URL=
TRANSLATION_API_KEY=
TRANSLATION_MODEL=

# --- Runtime --------------------------------------------------------------
FC2_CONFIG=/app/config/config.yaml
TZ=Asia/Shanghai
