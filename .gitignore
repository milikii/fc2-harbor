# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Local configuration and secrets — never commit
.env
.env.*
!.env.example
config/config.yaml
config/config.*.yaml
!config/example.yaml

# Runtime data (SQLite, image cache, logs)
data/
*.db
*.db-wal
*.db-shm
*.sqlite3
cache/

# OS noise
.DS_Store

# Deployment secrets (kept outside the repo, ignored defensively)
.secrets/
